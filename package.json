    "check-code-samples-usage": "node scripts/check-code-samples-usage.mjs",
    "check-openapi-routes-coverage": "node scripts/check-openapi-routes-coverage.mjs",
    "generate-changelog": "npx tsx scripts/generate-changelog.ts",
    "generate-error-codes": "node scripts/generate-error-codes.mjs",
    "check-broken-links": "node scripts/check-broken-links.mjs",
    "ingest": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --import tsx scripts/ingest/index.ts",
    "ingest:query": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --import tsx scripts/ingest/query.ts",
    "test:ingest": "vitest run scripts/ingest"
  }
