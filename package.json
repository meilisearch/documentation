    "github-slugger": "^2.0.0",
    "js-yaml": "^5.4.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-to-markdown": "^2.2.2",
    "mdast-util-to-string": "^4.0.0",
    "meilisearch": "^0.62.0",
    "node-fetch": "^2.7.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "yaml": "^2.9.1"
